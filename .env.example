ANTHROPIC_API_KEY=sk-ant-...
PORT=3000

# Kick category slugs to monitor (comma-separated)
KICK_CATEGORIES=slots-casino,gambling

# Minimum viewer count to consider a stream
MIN_VIEWERS=50

# Big win score threshold (1-10) — streams above this are flagged
BIGWIN_THRESHOLD=7

# Auto-scan interval in minutes (0 to disable)
SCAN_INTERVAL_MINUTES=5
